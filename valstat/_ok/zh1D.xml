<question type="multichoice">
  <name>
    <text>demorg2</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Legyen \(A\) és \(B\) két esemény, \(C=\overline {AB}\) és \(D=\overline {A}+\overline {B}\). Ekkor </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(P(C)=P(D)\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(C\) és \(D\) függetlenek</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(C\) és \(D\) kizárják egymást</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(C\) maga után vonja \(D\)-t, de fordítva nem</p>]]></text>
  </answer>
</question>
<question type="multichoice">
  <name>
    <text>flenes</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Azt mondjuk, hogy \(A\) és \(B\) események függetlenek, ha: </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(P(AB)=P(A)P(B)\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(P(A+B)=P(A)+P(B)\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(P(A+B)=P(A)+P(B)-P(AB)\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(P(AB)=P(A)+P(B)\)</p>]]></text>
  </answer>
</question>
<question type="multichoice">
  <name>
    <text>impl</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Ha \(A\) maga után vonja \(B\)-t akkor </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(P(A)\le P(B)\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(P(A)\neq P(B)\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(A\) és \(B\) függetlenek</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(A\) és \(B\) sosem következik be egyszerre</p>]]></text>
  </answer>
</question>
 
