<question type="multichoice">
  <name>
    <text>valelo</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Azt mondjuk, hogy a \(p_1,p_2,\ldots,p_k,\ldots\) számsorozat valószínűségeloszlás, ha: </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(p_k\ge 0\) és \(\sum _k p_k=1\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(p_k\ge p_{k+1}\) és \(\sum _k p_k&lt;\infty \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(p_k=\frac {1}{2^k}\ k\ge 1\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(p\) binomiális vagy geometriai</p>]]></text>
  </answer>
