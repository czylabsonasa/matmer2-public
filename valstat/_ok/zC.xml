    <text>pMul</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>A [0,1] intervallumon kiválasztunk két számot. Mennyi a valószínűsége, hogy az egyik szám több mint 2x akkora mint a másik? </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\frac {1}{2}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {3}{4}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {1}{4}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {1}{6}\)</p>]]></text>
  </answer>
</question>
<question type="multichoice">
