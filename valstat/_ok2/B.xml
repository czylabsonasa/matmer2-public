<question type="multichoice">
  <name>
    <text>boltExp</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Egy forgalmas benzinkútnál a tapasztalatok szerint a sorbanállás pillanatától a tankolás megkezdéséig eltelt percek száma exponenciális eloszlású. Tudjuk, hogy átlagosan \( 2 \) percet kell várni. Egy barátom felhív a sorbaállás kezdetekor, és azt mondja \( 3 \) perc múlva odajön. Mennyi a valsége, hogy még sorbanállok, amikor megérkezik. (tegyük fel, hogy valóban megérkezik a mondott időben.) </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\( e^{-\frac {3}{2}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( e^{-\frac {3}{4}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( e^{-\frac {1}{2}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( e^{-3} \)</p>]]></text>
  </answer>
</question>
