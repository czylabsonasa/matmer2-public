<question type="multichoice">
  <name>
    <text>boltExp</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Egy forgalmas benzinkútnál a tapasztalatok szerint a sorbanállás pillanatától a tankolás megkezdéséig eltelt percek száma exponenciális eloszlású. Tudjuk, hogy átlagosan \( 5 \) percet kell várni. Egy barátom felhív a sorbaállás kezdetekor, és azt mondja \( 7 \) perc múlva odajön. Mennyi a valsége, hogy még sorbanállok, amikor megérkezik. (tegyük fel, hogy valóban megérkezik a mondott időben.) </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\( e^{-\frac {7}{5}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( e^{-\frac {7}{10}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( e^{-\frac {7}{15}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( e^{-7} \)</p>]]></text>
  </answer>
</question>
