  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\frac {3}{100}, \frac {57}{100}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {3}{200}, \frac {43}{100}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {197}{200}, \frac {43}{300}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {197}{600}, \frac {257}{300}\)</p>]]></text>
  </answer>
</question>
