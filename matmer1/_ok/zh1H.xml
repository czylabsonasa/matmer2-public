  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\left [\frac {4}{7}, \frac {18}{7}, \frac {13}{7}\right ],\ -2\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {10}{7}, \frac {24}{7}, \frac {1}{7}\right ],\ -2\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {10}{7}, \frac {16}{7}, -\frac {11}{7}\right ],\ -4\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [-\frac {4}{7}, \frac {2}{7}, \frac {17}{7}\right ],\ -2\)</p>]]></text>
  </answer>
