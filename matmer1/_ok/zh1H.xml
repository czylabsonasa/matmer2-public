  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\frac {\left [ {\begin {array}{cc}0& 2\end {array}} \right ]}{\sqrt {4}}, \frac {\left [ {\begin {array}{cc}3& 0\end {array}} \right ]}{\sqrt {9}}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {\left [ {\begin {array}{cc}3& 2\end {array}} \right ]}{\sqrt {13}}, \frac {\left [ {\begin {array}{cc}3& 0\end {array}} \right ]}{\sqrt {9}}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {\left [ {\begin {array}{cc}-3& 2\end {array}} \right ]}{\sqrt {13}}, \frac {\left [ {\begin {array}{cc}3& 0\end {array}} \right ]}{\sqrt {9}}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {\left [ {\begin {array}{cc}-3& 2\end {array}} \right ]}{\sqrt {13}}, \frac {\left [ {\begin {array}{cc}0& 2\end {array}} \right ]}{\sqrt {4}}\)</p>]]></text>
  </answer>
