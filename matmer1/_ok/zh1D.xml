  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Legyen \(v=\left [2, 0, 0\right ]\) és \(w=\left [3, 3, 1\right ]\). Végezze el a következő vektorműveleteket: \(v+\frac {3}{10} w, \ vw^{T}\)! </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\left [\frac {29}{10}, \frac {9}{10}, \frac {3}{10}\right ],\ 6\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {11}{10}, -\frac {9}{10}, -\frac {3}{10}\right ],\ 6\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [-\frac {12}{5}, -3, -1\right ],\ 12\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {18}{5}, 3, 1\right ],\ 6\)</p>]]></text>
  </answer>
</question>
