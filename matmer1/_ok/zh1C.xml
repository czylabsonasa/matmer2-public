<question type="multichoice">
  <name>
    <text>vek</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Legyen \(v=\left [3, 1, -1\right ]\) és \(w=\left [-1, 3, 3\right ]\). Végezze el a következő vektorműveleteket: \(v+\frac {3}{10} w, \ vw^{T}\)! </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\left [\frac {27}{10}, \frac {19}{10}, -\frac {1}{10}\right ],\ -3\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {33}{10}, \frac {1}{10}, -\frac {19}{10}\right ],\ -3\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {19}{10}, -\frac {27}{10}, -\frac {33}{10}\right ],\ -6\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [-\frac {1}{10}, \frac {33}{10}, \frac {27}{10}\right ],\ -3\)</p>]]></text>
  </answer>
</question>
<question type="multichoice">
