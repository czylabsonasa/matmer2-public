  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Legyen \(v=\left [0, 2, 2\right ]\) és \(w=\left [-1, 0, 1\right ]\). Végezze el a következő vektorműveleteket: \(v+\frac {3}{10} w, \ vw^{T}\)! </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\left [-\frac {3}{10}, 2, \frac {23}{10}\right ],\ 2\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {3}{10}, 2, \frac {17}{10}\right ],\ 2\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [1, \frac {3}{5}, -\frac {2}{5}\right ],\ 4\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [-1, \frac {3}{5}, \frac {8}{5}\right ],\ 2\)</p>]]></text>
  </answer>
</question>
