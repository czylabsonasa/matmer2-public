  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\left [\frac {9}{7}, \frac {10}{7}, \frac {20}{7}\right ],\ 5\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [-\frac {9}{7}, \frac {4}{7}, \frac {8}{7}\right ],\ 5\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [-3, -\frac {4}{7}, -\frac {8}{7}\right ],\ 10\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [3, \frac {10}{7}, \frac {20}{7}\right ],\ 5\)</p>]]></text>
  </answer>
