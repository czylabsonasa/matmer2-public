<question type="multichoice">
  <name>
    <text>vek</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Legyen \(v=\left [3, -1, 2\right ]\) és \(w=\left [1, 2, 3\right ]\). Végezze el a következő vektorműveleteket: \(v+\frac {2}{7} w, \ vw^{T}\)! </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\left [\frac {23}{7}, -\frac {3}{7}, \frac {20}{7}\right ],\ 7\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {19}{7}, -\frac {11}{7}, \frac {8}{7}\right ],\ 7\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [-\frac {1}{7}, -\frac {16}{7}, -\frac {17}{7}\right ],\ 14\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {13}{7}, \frac {12}{7}, \frac {25}{7}\right ],\ 7\)</p>]]></text>
  </answer>
