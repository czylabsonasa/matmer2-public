<question type="multichoice">
  <name>
    <text>gram</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Ortonormálja a \( b_1=\left [3, 2\right ] \), \( b_2=\left [1, 2\right ] \) vektorrendszert! </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\( \frac {\left [3, 2\right ]}{\sqrt {13}}, \frac {\left [-\frac {8}{13}, \frac {12}{13}\right ]}{\sqrt {\frac {16}{13}}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( \frac {\left [\frac {31}{13}, \frac {38}{13}\right ]}{\sqrt {\frac {185}{13}}}, \frac {\left [-\frac {8}{13}, \frac {12}{13}\right ]}{\sqrt {\frac {16}{13}}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( \frac {\left [\frac {47}{13}, \frac {14}{13}\right ]}{\sqrt {\frac {185}{13}}}, \frac {\left [-\frac {8}{13}, \frac {12}{13}\right ]}{\sqrt {\frac {16}{13}}} \)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\( \frac {\left [\frac {47}{13}, \frac {14}{13}\right ]}{\sqrt {\frac {185}{13}}}, \frac {\left [3, 2\right ]}{\sqrt {13}} \)</p>]]></text>
  </answer>
</question>
