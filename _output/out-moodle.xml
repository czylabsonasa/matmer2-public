<question type="multichoice">
  <name>
    <text>gram</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Ortonormálja a \(b_1=\left [1, 0\right ]\), \(b_2=\left [1, 1\right ]\) vektorrendszert! </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\frac {\left [1, 0\right ]}{\sqrt {1}}, \frac {\left [0, 1\right ]}{\sqrt {1}}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {\left [1, 1\right ]}{\sqrt {2}}, \frac {\left [0, 1\right ]}{\sqrt {1}}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {\left [1, -1\right ]}{\sqrt {2}}, \frac {\left [0, 1\right ]}{\sqrt {1}}\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\frac {\left [1, -1\right ]}{\sqrt {2}}, \frac {\left [1, 0\right ]}{\sqrt {1}}\)</p>]]></text>
  </answer>
