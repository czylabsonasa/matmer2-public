  <answer fraction="100" format="html">
    <text><![CDATA[<p>\( \frac {\left [3, 0\right ]}{\sqrt {9}}, \frac {\left [0, 3\right ]}{\sqrt {9}} \)</p>]]></text>
  </answer>
