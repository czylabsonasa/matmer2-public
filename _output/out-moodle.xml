<question type="multichoice">
  <name>
    <text>vek</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Legyen \(v=\left [3, 3, 3\right ]\) és \(w=\left [1, 3, -1\right ]\). Végezze el a következő vektorműveleteket: \(v+\frac {2}{7} w, \ vw^{T}\)! </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.1000000</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>1</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\left [\frac {23}{7}, \frac {27}{7}, \frac {19}{7}\right ],\ 9\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {19}{7}, \frac {15}{7}, \frac {23}{7}\right ],\ 9\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [-\frac {1}{7}, -\frac {15}{7}, \frac {13}{7}\right ],\ 18\)</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\left [\frac {13}{7}, \frac {27}{7}, -\frac {1}{7}\right ],\ 9\)</p>]]></text>
  </answer>
</question>
<question type="multichoice">
